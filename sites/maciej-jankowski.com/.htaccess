# Apache / LiteSpeed config for the static version of maciej-jankowski.com
# Remove all old WordPress files (wp-*, index.php, xmlrpc.php...) from the server before uploading.

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + www (same canonical as the WordPress site)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.maciej-jankowski.com%{REQUEST_URI} [L,R=301]

  # Old WordPress URLs
  RewriteRule ^meet/?$ /meeting/ [L,R=301]
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json)(/.*)?$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
